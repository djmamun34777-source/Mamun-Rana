# GEMINI_API_KEY: Unused by this app (left commented out).
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# RESEND_API_KEY: Required to deliver real 6-digit OTP verification emails to the user's Google/Gmail inbox.
# Create a free API key at https://resend.com and add it in the AI Studio Secrets panel.
RESEND_API_KEY=MY_RESEND_API_KEY

# OTP_FROM_EMAIL: Verified sender address for OTP emails (defaults to onboarding@resend.dev).
OTP_FROM_EMAIL=onboarding@resend.dev
